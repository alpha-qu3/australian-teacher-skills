{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anthropics/k12-teacher-skills/localisation/replacement-matrix.schema.json",
  "title": "Reviewed localisation replacement row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory_id",
    "australian_or_qcaa_concept",
    "authority_tier",
    "mapping_strength",
    "rationale",
    "source_ids",
    "proposed_file_action",
    "reviewer_decision"
  ],
  "properties": {
    "inventory_id": { "type": "string", "pattern": "^US-[0-9]{4}$" },
    "australian_or_qcaa_concept": { "type": "string", "minLength": 1 },
    "authority_tier": { "type": "string", "enum": ["ACARA", "QCAA", "NCCD", "Queensland Education", "curriculum-neutral"] },
    "mapping_strength": { "type": "string", "enum": ["exact", "partial", "contextual", "no-equivalent"] },
    "rationale": { "type": "string", "minLength": 1 },
    "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^SRC-[0-9]{4}$" } },
    "proposed_file_action": { "type": "string", "enum": ["retain", "replace", "rename", "remove", "split", "review"] },
    "reviewer_decision": { "type": "string", "enum": ["accepted", "rejected", "revision-requested", "pending"] }
  }
}
